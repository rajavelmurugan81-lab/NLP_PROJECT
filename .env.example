# Project Environment Configuration
PROJECT_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data
MODEL_DIR=./models
RESULTS_DIR=./results

# LLM Provider Configuration (Optional - Defaults to mock for offline testing)
# Options for LLM_PROVIDER: mock, openai, ollama
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM / Ollama Configuration (Optional)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1/chat/completions

